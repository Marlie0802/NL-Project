[Unit]
Description=ChallengeLab FastAPI
After=network.target

[Service]
User=team
Group=team
WorkingDirectory=/opt/challengelab
Environment="PATH=/opt/challengelab/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/challengelab/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# =========================================================
# Basisfuncties
# =========================================================

def get_challenge(challenge_id: str):
    """
    Zoek één challenge op basis van zijn ID.
    Geeft None terug wanneer de challenge niet bestaat.
    """

    return next(
        (
            challenge
            for challenge in CHALLENGES
            if challenge["id"] == challenge_id
        ),
        None
    )


def get_enabled_challenges():
    """
    Geef alle challenges terug die momenteel beschikbaar zijn.
    """

    return [
        challenge
        for challenge in CHALLENGES
        if challenge["enabled"]
    ]


def get_enabled_challenges_by_level(
    difficulty_level: int
):
    """
    Geef alle actieve challenges van één niveau terug.
    """

    return [
        challenge
        for challenge in CHALLENGES
        if (
            challenge["enabled"]
            and
            challenge["difficulty_level"]
            == difficulty_level
        )
    ]


def get_public_challenge(challenge: dict):
    """
    Veilige challenge-informatie voor API-responses.

    Antwoorden en hints worden hierbij bewust niet meegestuurd.
    """

    return {
        "id": challenge["id"],
        "name": challenge["name"],
        "difficulty_level": (
            challenge["difficulty_level"]
        ),
        "difficulty": challenge["difficulty"],
        "category": challenge["category"],
        "description": challenge["description"],
        "enabled": challenge["enabled"]
    }


def get_catalog(
    include_disabled: bool = False
):
    """
    Geef de challengecatalogus terug.

    include_disabled=False:
        alleen speelbare challenges.

    include_disabled=True:
        alle 20 challenges, bijvoorbeeld voor admin.
    """

    if include_disabled:
        challenges = CHALLENGES
    else:
        challenges = get_enabled_challenges()

    return [
        get_public_challenge(challenge)
        for challenge in challenges
    ]


# =========================================================
# Gebalanceerd pakket
# =========================================================

def generate_balanced_package(
    challenges_per_level: int = 2
):
    """
    Genereer een pakket dat van makkelijk naar moeilijk loopt.

    Standaard:
        2x niveau 1
        2x niveau 2
        2x niveau 3
        2x niveau 4
        2x niveau 5

    Binnen ieder niveau worden willekeurige challenges gekozen.

    Deze functie wordt pas gebruikt wanneer van ieder niveau
    voldoende challenges enabled zijn.
    """

    selected = []

    for level in range(1, 6):

        available = (
            get_enabled_challenges_by_level(
                level
            )
        )

        if len(available) < challenges_per_level:
            raise ValueError(
                (
                    f"Niveau {level} heeft slechts "
                    f"{len(available)} actieve challenge(s), "
                    f"maar {challenges_per_level} nodig."
                )
            )

        level_selection = random.sample(
            available,
            challenges_per_level
        )

        random.shuffle(
            level_selection
        )

        selected.extend(
            level_selection
        )

    return selected


# =========================================================
# Handmatig pakket controleren
# =========================================================

def validate_manual_package(
    challenge_ids: list[str],
    expected_count: int = 10
):
    """
    Controleer een handmatig samengesteld pakket.

    - exact het juiste aantal
    - geen dubbele challenges
    - alle challenges bestaan
    - alle challenges zijn enabled

    Het resultaat wordt automatisch van makkelijk naar
    moeilijk gesorteerd.
    """

    if len(challenge_ids) != expected_count:
        raise ValueError(
            (
                f"Een pakket moet exact "
                f"{expected_count} challenges bevatten."
            )
        )

    if len(set(challenge_ids)) != len(
        challenge_ids
    ):
        raise ValueError(
            "Een challenge mag maar één keer voorkomen."
        )

    selected = []

    for challenge_id in challenge_ids:

        challenge = get_challenge(
            challenge_id
        )

        if not challenge:
            raise ValueError(
                (
                    f"Onbekende challenge: "
                    f"{challenge_id}"
                )
            )

        if not challenge["enabled"]:
            raise ValueError(
                (
                    f"Challenge '{challenge['name']}' "
                    f"is nog niet beschikbaar."
                )
            )

        selected.append(
            challenge
        )

    # Eerst niveau 1, daarna 2, 3, 4 en 5.
    # Binnen hetzelfde niveau blijft de gekozen volgorde behouden.
    selected.sort(
        key=lambda challenge: (
            challenge["difficulty_level"]
        )
    )

    return selected


# =========================================================
# Losse challenge controleren
# =========================================================

def validate_single_challenge(
    challenge_id: str
):
    """
    Controleer of een losse challenge speelbaar is.
    """

    challenge = get_challenge(
        challenge_id
    )

    if not challenge:
        raise ValueError(
            "Challenge bestaat niet."
        )

    if not challenge["enabled"]:
        raise ValueError(
            (
                f"Challenge '{challenge['name']}' "
                f"is nog niet beschikbaar."
            )
        )

    return challenge


# =========================================================
# Statistieken
# =========================================================

def challenge_statistics():
    """
    Handig voor admin/dashboard.
    """

    levels = {}

    for level in range(1, 6):

        all_on_level = [
            challenge
            for challenge in CHALLENGES
            if challenge["difficulty_level"] == level
        ]

        enabled_on_level = [
            challenge
            for challenge in all_on_level
            if challenge["enabled"]
        ]

        levels[level] = {
            "total": len(all_on_level),
            "enabled": len(
                enabled_on_level
            )
        }

    return {
        "total": len(CHALLENGES),
        "enabled": len(
            get_enabled_challenges()
        ),
        "levels": levels
    }

/* =========================================
   API
========================================= */

async function api(
    url,
    options = {}
) {
    const response =
        await fetch(
            url,
            {
                credentials:
                    "same-origin",
                ...options
            }
        );

    const raw =
        await response.text();

    let data = {};

    if (raw) {
        try {
            data =
                JSON.parse(raw);
        } catch {
            throw new Error(
                "Ongeldige serverresponse"
            );
        }
    }

    if (!response.ok) {
        const error =
            new Error(
                data.detail ||
                "Er ging iets mis"
            );

        error.status =
            response.status;

        throw error;
    }

    return data;
}


/* =========================================
   LOGIN
========================================= */


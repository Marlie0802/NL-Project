function updateSessionMode() {
    const mode =
        document
            .querySelector(
                'input[name="sessionMode"]:checked'
            )
            ?.value;

    document
        .getElementById(
            "randomPackageOptions"
        )
        .classList.toggle(
            "hidden",
            mode !== "package-random"
        );

    document
        .getElementById(
            "manualPackageOptions"
        )
        .classList.toggle(
            "hidden",
            mode !== "package-manual"
        );

    document
        .getElementById(
            "singleOptions"
        )
        .classList.toggle(
            "hidden",
            mode !== "single"
        );
}


/* =========================================
   HANDMATIG PAKKET
========================================= */

function renderManualPackage() {
    const container =
        document.getElementById(
            "manualChallengeList"
        );

    if (!container) {
        return;
    }

    const sorted =
        [...challenges]
            .sort(
                (a, b) => {
                    const levelDifference =
                        a.difficulty_level
                        - b.difficulty_level;

                    if (levelDifference !== 0) {
                        return levelDifference;
                    }

                    return a.name.localeCompare(
                        b.name,
                        "nl"
                    );
                }
            );

    let html = "";

    for (
        let level = 1;
        level <= 5;
        level++
    ) {
        const levelChallenges =
            sorted.filter(
                challenge =>
                    challenge.difficulty_level
                    === level
            );

        if (!levelChallenges.length) {
            continue;
        }

        html += `
            <div
                style="
                    margin: 14px 0 8px;
                    color: #35f29a;
                    font-weight: bold;
                "
            >
                Niveau ${level}
            </div>
        `;

        for (
            const challenge
            of levelChallenges
        ) {
            html += `
                <label
                    style="
                        display:flex;
                        align-items:flex-start;
                        gap:10px;
                        padding:9px 5px;
                        cursor:pointer;
                    "
                >
                    <input
                        type="checkbox"
                        class="manual-package-challenge"
                        value="${escapeHtml(
                            challenge.id
                        )}"
                        onchange="updateManualPackageCount(this)"
                    >

                    <span>
                        <strong>
                            ${escapeHtml(
                                challenge.name
                            )}
                        </strong>

                        <br>

                        <span class="muted">
                            ${escapeHtml(
                                challenge.category
                            )}
                            ·
                            ${escapeHtml(
                                challenge.difficulty
                            )}
                        </span>
                    </span>
                </label>
            `;
        }
    }

    container.innerHTML =
        html;

    updateManualPackageCount();
}


function updateManualPackageCount(
    changedCheckbox = null
) {
    let selected =
        [
            ...document.querySelectorAll(
                ".manual-package-challenge:checked"
            )
        ];

    if (
        selected.length > 10
        && changedCheckbox
    ) {
        changedCheckbox.checked =
            false;

        selected =
            [
                ...document.querySelectorAll(
                    ".manual-package-challenge:checked"
                )
            ];
    }

    const count =
        selected.length;

    const countElement =
        document.getElementById(
            "manualPackageCount"
        );

    if (countElement) {
        countElement.textContent =
            `${count} / 10 geselecteerd`;

        countElement.style.color =
            count === 10
            ? "#35f29a"
            : "#f7c86a";
    }

    document
        .querySelectorAll(
            ".manual-package-challenge:not(:checked)"
        )
        .forEach(
            checkbox => {
                checkbox.disabled =
                    count >= 10;
            }
        );
}


function getManualPackageIds() {
    const selectedIds =
        new Set(
            [
                ...document.querySelectorAll(
                    ".manual-package-challenge:checked"
                )
            ].map(
                checkbox =>
                    checkbox.value
            )
        );

    return [...challenges]
        .filter(
            challenge =>
                selectedIds.has(
                    challenge.id
                )
        )
        .sort(
            (a, b) => {
                const levelDifference =
                    a.difficulty_level
                    - b.difficulty_level;

                if (levelDifference !== 0) {
                    return levelDifference;
                }

                return a.name.localeCompare(
                    b.name,
                    "nl"
                );
            }
        )
        .map(
            challenge =>
                challenge.id
        );
}


async function startSession() {
    const error =
        document
            .getElementById(
                "startSessionError"
            );

    error.textContent = "";

    error.classList.add(
        "hidden"
    );

    const teamId =
        Number(
            value(
                "startTeamId"
            )
        );

    const mode =
        document
            .querySelector(
                'input[name="sessionMode"]:checked'
            )
            ?.value;

    try {
        if (
            mode === "single"
        ) {
            await api(
                `/api/gameleader/teams/${teamId}/sessions/single`,
                {
                    method:
                        "POST",

                    headers:
                        jsonHeaders(),

                    body:
                        JSON.stringify({
                            challenge_id:
                                value(
                                    "singleChallenge"
                                )
                        })
                }
            );

        } else if (
            mode === "package-manual"
        ) {
            const challengeIds =
                getManualPackageIds();

            if (
                challengeIds.length !== 10
            ) {
                throw new Error(
                    "Selecteer precies 10 challenges."
                );
            }

            await api(
                `/api/gameleader/teams/${teamId}/sessions/package`,
                {
                    method:
                        "POST",

                    headers:
                        jsonHeaders(),

                    body:
                        JSON.stringify({
                            challenge_ids:
                                challengeIds,

                            use_saved_assignments:
                                false
                        })
                }
            );

        } else if (
            mode === "package-random"
        ) {
            await api(
                `/api/gameleader/teams/${teamId}/sessions/package`,
                {
                    method:
                        "POST",

                    headers:
                        jsonHeaders(),

                    body:
                        JSON.stringify({
                            challenge_ids:
                                null,

                            use_saved_assignments:
                                false
                        })
                }
            );

        } else {
            throw new Error(
                "Kies eerst een sessietype."
            );
        }


        closeModal(
            "startSessionModal"
        );

        await Promise.all([
            loadTeams(),
            loadSessions()
        ]);

        alert(
            "Sessie gestart."
        );

    } catch (err) {
        error.textContent =
            err.message;

        error.classList.remove(
            "hidden"
        );
    }
}



function closeModal(
    modalId
) {
    document
        .getElementById(
            modalId
        )
        .classList.add(
            "hidden"
        );
}


function summaryItem(
    label,
    value
) {
    return `
        <div class="summary-item">

            <span class="summary-label">
                ${escapeHtml(label)}
            </span>

            <span class="summary-value">
                ${escapeHtml(value)}
            </span>

        </div>
    `;
}


function badge(
    text,
    type
) {
    const classes = {
        active:
            "badge-active",

        disabled:
            "badge-disabled",

        warning:
            "badge-warning",

        neutral:
            "badge-neutral"
    };

    return `
        <span
            class="badge ${
                classes[type]
                || "badge-neutral"
            }"
        >
            ${escapeHtml(text)}
        </span>
    `;
}


function statusBadge(
    status
) {
    if (
        status === "active"
    ) {
        return badge(
            "Actief",
            "active"
        );
    }

    if (
        status === "completed"
    ) {
        return badge(
            "Voltooid",
            "neutral"
        );
    }

    if (
        status === "cancelled"
    ) {
        return badge(
            "Geannuleerd",
            "disabled"
        );
    }

    return badge(
        status,
        "warning"
    );
}


function translateStatus(
    status
) {
    const values = {
        active:
            "Actief",

        completed:
            "Voltooid",

        cancelled:
            "Geannuleerd",

        waiting:
            "Wachtend"
    };

    return values[status]
        || status;
}


function jsonHeaders() {
    return {
        "Content-Type":
            "application/json"
    };
}


function value(
    id
) {
    return document
        .getElementById(id)
        .value;
}


function formatDate(
    value
) {
    if (!value) {
        return "-";
    }

    return new Date(
        value
    )
        .toLocaleString(
            "nl-NL"
        );
}


function escapeHtml(
    value
) {
    return String(
        value ?? ""
    )
        .replaceAll(
            "&",
            "&amp;"
        )
        .replaceAll(
            "<",
            "&lt;"
        )
        .replaceAll(
            ">",
            "&gt;"
        )
        .replaceAll(
            '"',
            "&quot;"
        )
        .replaceAll(
            "'",
            "&#039;"
        );
}



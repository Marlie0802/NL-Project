                    <th>Acties</th>
                </tr>
            </thead>

            <tbody>
                ${filtered.map(
                    session => `
                        <tr>

                            <td>
                                ${escapeHtml(
                                    session.team.display_name
                                )}
                            </td>

                            <td>
                                ${statusBadge(
                                    session.status
                                )}
                            </td>

                            <td>
                                ${
                                    session.mode
                                    === "single"
                                    ? "Los"
                                    : "Pakket"
                                }
                            </td>

                            <td>
                                ${session.completed}
                                /
                                ${session.total}
                            </td>

                            <td>
                                ${session.wrong_attempts}
                            </td>

                            <td>
                                ${session.hints_used}
                            </td>

                            <td class="score">
                                ${session.score}
                            </td>

                            <td>
                                ${formatDate(
                                    session.started_at
                                )}
                            </td>

                            <td class="actions-cell">

                                <button
                                    class="btn-small"
                                    onclick="openSession(
                                        '${session.id}'
                                    )"
                                >
                                    Bekijken
                                </button>

                                ${
                                    session.status !== "active"
                                    ? `
                                        <button
                                            class="btn-small"
                                            onclick="downloadReport(
                                                '${session.id}'
                                            )"
                                        >
                                            Rapport
                                        </button>
                                    `
                                    : ""
                                }

                            </td>

                        </tr>
                    `
                ).join("")}
            </tbody>
        </table>
    `;
}


/* =========================================
   SESSIEDETAIL
========================================= */

async function openSession(
    sessionId
) {
    try {
        selectedSessionId =
            sessionId;

        const data =
            await api(
                `/api/gameleader/sessions/${sessionId}`
            );

        document
            .getElementById(
                "sessionModalTitle"
            )
            .textContent =
                `Sessie · ${data.team.display_name}`;

        document
            .getElementById(
                "sessionSummary"
            )
            .innerHTML = `
                ${summaryItem(
                    "Status",
                    translateStatus(
                        data.status
                    )
                )}

                ${summaryItem(
                    "Type",
                    data.mode === "single"
                    ? "Losse challenge"
                    : "Pakket"
                )}

                ${summaryItem(
                    "Voortgang",
                    `${data.current} / ${data.total}`
                )}

                ${summaryItem(
                    "Gestart",
                    formatDate(
                        data.started_at
                    )
                )}
            `;

        document
            .getElementById(
                "stopSessionButton"
            )
            .classList.toggle(
                "hidden",
                data.status
                !== "active"
            );

        document
            .getElementById(
                "messageText"
            )
            .value = "";

        document
            .getElementById(
                "messageError"
            )
            .classList.add(
                "hidden"
            );

        await loadMessages();

        document
            .getElementById(
                "sessionModal"
            )
            .classList.remove(
                "hidden"
            );

    } catch (err) {
        alert(err.message);
    }
}



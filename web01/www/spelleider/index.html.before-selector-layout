<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>BreachOut Spelleider</title>

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --green: #35f29a;
            --green-light: #68ffb5;
            --background: #050b08;
            --panel: #0a140f;
            --panel-light: #0d1812;
            --border: #1b3225;
            --border-light: #294235;
            --text: #edf5f0;
            --muted: #7d8c83;
            --danger: #ff9696;
            --warning: #ffd071;
        }

        body {
            margin: 0;
            min-height: 100vh;

            color: var(--text);

            font-family:
                Arial,
                sans-serif;

            background:
                linear-gradient(
                    rgba(0,255,140,.025) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(0,255,140,.025) 1px,
                    transparent 1px
                ),
                var(--background);

            background-size:
                40px 40px;
        }

        *::selection {
            color: #04100a;
            background: var(--green);
        }

        .hidden {
            display: none !important;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        /* =========================================
           ALGEMEEN
        ========================================= */

        .logo {
            font-size: 25px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .logo span {
            color: var(--green);
        }

        .product-tag {
            margin-top: 4px;

            color: #59685f;

            font-size: 10px;
            letter-spacing: 1.4px;

            text-transform: uppercase;
        }

        .muted {
            color: var(--muted);
        }

        .empty {
            padding: 32px;

            color: #66756c;

            text-align: center;
        }

        /* =========================================
           LOGIN
        ========================================= */

        .login-page {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 24px;
        }

        .login-box {
            width: 430px;
            max-width: 100%;

            padding: 33px;

            border: 1px solid var(--border);
            border-radius: 16px;

            background: #0b1510;

            box-shadow:
                0 30px 80px
                rgba(0,0,0,.35);
        }

        .login-box h1 {
            margin: 28px 0 7px;

            font-size: 25px;
        }

        .login-box p {
            margin: 0 0 27px;

            color: var(--muted);

            line-height: 1.55;
        }

        label {
            display: block;

            margin-bottom: 7px;

            color: #aab6af;

            font-size: 13px;
        }

        input,
        select,
        textarea {
            width: 100%;

            padding: 12px 13px;

            border: 1px solid var(--border-light);
            border-radius: 8px;

            outline: none;

            color: white;

            background: #07100b;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: var(--green);
        }

        textarea {
            min-height: 110px;
            resize: vertical;
        }

        .form-group {
            margin-bottom: 17px;
        }

        .error-message {
            margin-top: 14px;

            color: #ff9e9e;

            font-size: 13px;
        }

        /* =========================================
           BUTTONS
        ========================================= */

        .btn-primary,
        .btn-secondary,
        .btn-danger,
        .btn-warning,
        .btn-small {
            border-radius: 8px;
        }

        .btn-primary {
            padding: 11px 16px;

            border: 0;

            color: #031109;

            font-weight: 700;

            background: var(--green);
        }

        .btn-primary:hover {
            background: var(--green-light);
        }

        .btn-secondary {
            padding: 10px 14px;

            border: 1px solid #2b4034;

            color: white;

            background: #111b15;
        }

        .btn-danger {
            padding: 10px 14px;

            border: 1px solid #4b292a;

            color: var(--danger);

            background: #1b1112;
        }

        .btn-warning {
            padding: 10px 14px;

            border: 1px solid #5a4822;

            color: var(--warning);

            background: #18150b;
        }

        .btn-small {
            padding: 7px 10px;

            border: 1px solid #2b4135;

            color: #d6dfda;

            background: #101a14;

            font-size: 12px;
        }

        .btn-small:hover {
            border-color: var(--green);
        }

        .btn-small:disabled {
            opacity: .35;
            cursor: not-allowed;
            border-color: #26332c;
            color: #69756e;
        }

        .btn-small:disabled:hover {
            border-color: #26332c;
        }

        .btn-small.danger {
            color: var(--danger);
        }

        .btn-small.warning {
            color: var(--warning);
        }

        .btn-full {
            width: 100%;
        }

        /* =========================================
           LAYOUT
        ========================================= */

        .layout {
            display: grid;

            grid-template-columns:
                230px
                1fr;

            min-height: 100vh;
        }

        aside {
            position: sticky;
            top: 0;

            height: 100vh;

            padding: 26px 18px;

            border-right:
                1px solid
                #172a20;

            background: #08110c;
        }

        .aside-brand {
            margin:
                0 10px
                34px;
        }

        nav {
            display: grid;
            gap: 5px;
        }

        .nav-button {
            width: 100%;

            padding: 12px 14px;

            border: 0;
            border-radius: 8px;

            color: #84928a;

            text-align: left;

            background: transparent;
        }

        .nav-button:hover {
            color: white;

            background: #101c15;
        }

        .nav-button.active {
            color: var(--green);

            background:
                rgba(
                    53,
                    242,
                    154,
                    .10
                );
        }

        .nav-button.logout {
            margin-top: 25px;

            color: var(--danger);
        }

        main {
            min-width: 0;

            padding: 34px;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

            margin-bottom: 31px;
        }

        .topbar h1 {
            margin: 0;

            font-size: 30px;
        }

        .profile {
            text-align: right;
        }

        .profile-name {
            font-size: 14px;
        }

        .profile-role {
            margin-top: 3px;

            color: var(--muted);

            font-size: 11px;
        }

        /* =========================================
           PANELS / STATS
        ========================================= */

        .stats {
            display: grid;

            grid-template-columns:
                repeat(
                    auto-fit,
                    minmax(170px, 1fr)
                );

            gap: 14px;

            margin-bottom: 24px;
        }

        .stat-card,
        .panel {
            border: 1px solid var(--border);
            border-radius: 12px;

            background:
                rgba(
                    10,
                    20,
                    15,
                    .94
                );
        }

        .stat-card {
            padding: 19px;
        }

        .stat-label {
            margin-bottom: 9px;

            color: #718078;

            font-size: 11px;

            text-transform: uppercase;
        }

        .stat-number {
            color: var(--green);

            font-size: 30px;

            font-weight: 700;
        }

        .panel {
            margin-bottom: 22px;

            padding: 23px;
        }

        .panel-header {
            display: flex;

            align-items: center;
            justify-content: space-between;

            gap: 15px;

            margin-bottom: 20px;
        }

        .panel-header h2 {
            margin: 0;

            font-size: 21px;
        }

        /* =========================================
           TABLE
        ========================================= */

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;

            border-collapse: collapse;
        }

        th,
        td {
            padding: 12px 10px;

            border-bottom:
                1px solid
                #172a20;

            text-align: left;

            vertical-align: middle;
        }

        th {
            color: #6f8076;

            font-size: 11px;

            text-transform: uppercase;
        }

        td {
            color: #dce5df;

            font-size: 14px;
        }

        .score {
            color: var(--green);

            font-weight: 700;
        }

        .actions-cell {
            min-width: 220px;
        }

        .actions-cell button {
            margin:
                2px 3px
                2px 0;
        }

        /* =========================================
           BADGES
        ========================================= */

        .badge {
            display: inline-block;

            padding: 5px 9px;

            border-radius: 20px;

            font-size: 11px;
        }

        .badge-active {
            color: var(--green);

            background:
                rgba(
                    53,
                    242,
                    154,
                    .10
                );
        }

        .badge-disabled {
            color: var(--danger);

            background:
                rgba(
                    255,
                    100,
                    100,
                    .10
                );
        }

        .badge-warning {
            color: var(--warning);

            background:
                rgba(
                    255,
                    208,
                    113,
                    .09
                );
        }

        .badge-neutral {
            color: #b1bbb5;

            background:
                rgba(
                    255,
                    255,
                    255,
                    .06
                );
        }

        /* =========================================
           FILTERS
        ========================================= */

        .filters {
            display: flex;
            flex-wrap: wrap;

            gap: 8px;

            margin-bottom: 19px;
        }

        .filter-button.active {
            color: var(--green);

            border-color: var(--green);

            background:
                rgba(
                    53,
                    242,
                    154,
                    .08
                );
        }

        /* =========================================
           MODAL
        ========================================= */

        .modal-backdrop {
            position: fixed;

            inset: 0;

            z-index: 100;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 20px;

            background:
                rgba(
                    0,
                    0,
                    0,
                    .76
                );
        }

        .modal {
            width: 520px;
            max-width: 100%;
            max-height: 90vh;

            overflow-y: auto;

            padding: 25px;

            border: 1px solid var(--border-light);
            border-radius: 14px;

            background: #0b1510;
        }

        .modal.large {
            width: 760px;
        }

        .modal h2 {
            margin: 0 0 20px;
        }

        .modal-actions {
            display: flex;

            justify-content: flex-end;

            flex-wrap: wrap;

            gap: 9px;

            margin-top: 22px;
        }

        .radio-row {
            display: flex;

            gap: 18px;

            margin-bottom: 20px;
        }

        .radio-row label {
            display: flex;
            align-items: center;

            gap: 7px;

            margin: 0;
        }

        .radio-row input {
            width: auto;
        }

        /* =========================================
           SESSIEDETAILS
        ========================================= */

        .session-summary {
            display: grid;

            grid-template-columns:
                repeat(
                    auto-fit,
                    minmax(140px, 1fr)
                );

            gap: 10px;

            margin-bottom: 20px;
        }

        .summary-item {
            padding: 13px;

            border: 1px solid #20382a;
            border-radius: 8px;

            background: #09130e;
        }

        .summary-label {
            display: block;

            margin-bottom: 6px;

            color: #68776f;

            font-size: 10px;

            text-transform: uppercase;
        }

        .summary-value {
            font-size: 14px;
        }

        .quick-messages {
            display: flex;
            flex-wrap: wrap;

            gap: 7px;

            margin: 8px 0 18px;
        }

        .message-history {
            display: grid;

            gap: 8px;

            max-height: 260px;

            overflow-y: auto;

            margin-top: 15px;
        }

        .message-row {
            padding: 11px 13px;

            border: 1px solid #20382a;
            border-radius: 8px;

            background: #09130e;
        }

        .message-row.hint {
            border-color: #554723;
        }

        .message-row-head {
            display: flex;

            justify-content: space-between;

            margin-bottom: 5px;

            color: var(--muted);

            font-size: 11px;
        }

        .message-row.hint
        .message-row-head {
            color: var(--warning);
        }

        @media (max-width: 850px) {
            .layout {
                grid-template-columns: 1fr;
            }

            aside {
                position: static;

                height: auto;

                border-right: 0;
                border-bottom:
                    1px solid
                    #172a20;
            }

            nav {
                grid-template-columns:
                    repeat(
                        2,
                        minmax(0, 1fr)
                    );
            }

            main {
                padding: 22px;
            }
        }
    </style>
</head>

<body>

<!-- =========================================
     LOGIN
========================================= -->

<section
    id="loginPage"
    class="login-page"
>

    <div class="login-box">

        <div class="logo">
            Breach<span>Out</span>
        </div>

        <div class="product-tag">
            Spelleider
        </div>

        <h1>
            Welkom
        </h1>

        <p>
            Meld je aan om jouw teams,
            sessies en live begeleiding
            te beheren.
        </p>

        <form id="loginForm">

            <div class="form-group">

                <label>
                    Gebruikersnaam
                </label>

                <input
                    id="loginUsername"
                    autocomplete="username"
                    required
                >

            </div>

            <div class="form-group">

                <label>
                    Wachtwoord
                </label>

                <input
                    id="loginPassword"
                    type="password"
                    autocomplete="current-password"
                    required
                >

            </div>

            <button
                class="btn-primary btn-full"
                type="submit"
            >
                Inloggen
            </button>

        </form>

        <div
            id="loginError"
            class="error-message hidden"
        ></div>

    </div>

</section>


<!-- =========================================
     PORTAL
========================================= -->

<section
    id="portal"
    class="layout hidden"
>

    <aside>

        <div class="aside-brand">

            <div class="logo">
                Breach<span>Out</span>
            </div>

            <div class="product-tag">
                Spelleider
            </div>

        </div>

        <nav>

            <button
                class="nav-button active"
                data-page="dashboard"
                onclick="showPage('dashboard')"
            >
                Dashboard
            </button>

            <button
                class="nav-button"
                data-page="teams"
                onclick="showPage('teams')"
            >
                Teams
            </button>

            <button
                class="nav-button"
                data-page="sessions"
                onclick="showPage('sessions')"
            >
                Sessies
            </button>

            <button
                class="nav-button"
                data-page="challenges"
                onclick="showPage('challenges')"
            >
                Challenges
            </button>

            <button
                class="nav-button"
                data-page="scoreboard"
                onclick="showPage('scoreboard')"
            >
                Scoreboard
            </button>

            <button
                class="nav-button logout"
                onclick="logout()"
            >
                Uitloggen
            </button>

        </nav>

    </aside>


    <main>

        <div class="topbar">

            <h1 id="pageTitle">
                Dashboard
            </h1>

            <div class="profile">

                <div
                    id="gameleaderName"
                    class="profile-name"
                ></div>

                <div class="profile-role">
                    Spelleider
                </div>

            </div>

        </div>


        <!-- DASHBOARD -->

        <section id="page-dashboard">

            <div class="stats">

                <div class="stat-card">

                    <div class="stat-label">
                        Teams
                    </div>

                    <div
                        id="statTeams"
                        class="stat-number"
                    >
                        0
                    </div>

                </div>

                <div class="stat-card">

                    <div class="stat-label">
                        Actieve sessies
                    </div>

                    <div
                        id="statActiveSessions"
                        class="stat-number"
                    >
                        0
                    </div>

                </div>

                <div class="stat-card">

                    <div class="stat-label">
                        Voltooide sessies
                    </div>

                    <div
                        id="statCompletedSessions"
                        class="stat-number"
                    >
                        0
                    </div>

                </div>

                <div class="stat-card">

                    <div class="stat-label">
                        Foute antwoorden
                    </div>

                    <div
                        id="statWrongAnswers"
                        class="stat-number"
                    >
                        0
                    </div>

                </div>

                <div class="stat-card">

                    <div class="stat-label">
                        Gebruikte hints
                    </div>

                    <div
                        id="statHints"
                        class="stat-number"
                    >
                        0
                    </div>

                </div>

                <div class="stat-card">

                    <div class="stat-label">
                        Hoogste score
                    </div>

                    <div
                        id="statHighscore"
                        class="stat-number"
                    >
                        0
                    </div>

                </div>

            </div>


            <div class="panel">

                <div class="panel-header">

                    <h2>
                        Actieve sessies
                    </h2>

                    <button
                        class="btn-small"
                        onclick="refreshEverything()"
                    >
                        Vernieuwen
                    </button>

                </div>

                <div
                    id="dashboardSessions"
                    class="table-wrap"
                >
                    Laden...
                </div>

            </div>

        </section>


        <!-- TEAMS -->

        <section
            id="page-teams"
            class="hidden"
        >

            <div class="panel">

                <div class="panel-header">

                    <h2>
                        Teams
                    </h2>

                    <div style="display:flex; gap:8px;">

                        <button
                            class="btn-primary"
                            onclick="openTeamModal()"
                        >
                            + Team
                        </button>

                        <button
                            class="btn-small"
                            onclick="loadTeams()"
                        >
                            Vernieuwen
                        </button>

                    </div>

                </div>

                <div
                    id="teamsContainer"
                    class="table-wrap"
                >
                    Laden...
                </div>

            </div>

        </section>


        <!-- SESSIES -->

        <section
            id="page-sessions"
            class="hidden"
        >

            <div class="panel">

                <div class="panel-header">

                    <h2>
                        Sessies
                    </h2>

                    <button
                        class="btn-small"
                        onclick="loadSessions()"
                    >
                        Vernieuwen
                    </button>

                </div>

                <div class="filters">

                    <button
                        class="btn-small filter-button active"
                        data-filter="all"
                        onclick="setSessionFilter('all')"
                    >
                        Alles
                    </button>

                    <button
                        class="btn-small filter-button"
                        data-filter="active"
                        onclick="setSessionFilter('active')"
                    >
                        Actief
                    </button>

                    <button
                        class="btn-small filter-button"
                        data-filter="completed"
                        onclick="setSessionFilter('completed')"
                    >
                        Voltooid
                    </button>

                    <button
                        class="btn-small filter-button"
                        data-filter="cancelled"
                        onclick="setSessionFilter('cancelled')"
                    >
                        Geannuleerd
                    </button>

                </div>

                <div
                    id="sessionsContainer"
                    class="table-wrap"
                >
                    Laden...
                </div>

            </div>

        </section>


        <!-- CHALLENGES -->

        <section
            id="page-challenges"
            class="hidden"
        >

            <div class="panel">

                <div class="panel-header">

                    <h2>
                        Beschikbare challenges
                    </h2>

                    <button
                        class="btn-small"
                        onclick="loadChallenges()"
                    >
                        Vernieuwen
                    </button>

                </div>

                <div
                    id="challengesContainer"
                    class="table-wrap"
                >
                    Laden...
                </div>

            </div>

        </section>

        <!-- SCOREBOARD -->

        <section
            id="page-scoreboard"
            class="hidden"
        >

            <div class="panel">

                <div class="panel-header">

                    <div>
                        <h2>
                            Scoreboard
                        </h2>

                        <div
                            class="muted"
                            style="margin-top:6px"
                        >
                            Alleen teams van jouw bedrijf worden hier getoond.
                        </div>
                    </div>

                    <button
                        class="btn-small"
                        onclick="loadScoreboard()"
                    >
                        Vernieuwen
                    </button>

                </div>

                <div
                    id="scoreboardContainer"
                    class="table-wrap"
                >
                    Laden...
                </div>

            </div>

        </section>


    </main>

</section>


<!-- =========================================
     START SESSIE
========================================= -->

<div
    id="startSessionModal"
    class="modal-backdrop hidden"
>

    <div class="modal">

        <h2 id="startSessionTitle">
            Sessie starten
        </h2>

        <input
            id="startTeamId"
            type="hidden"
        >

        <div class="radio-row">

            <label>
                <input
                    type="radio"
                    name="sessionMode"
                    value="package-random"
                    checked
                    onchange="updateSessionMode()"
                >

                Willekeurig pakket
            </label>

            <label>
                <input
                    type="radio"
                    name="sessionMode"
                    value="package-manual"
                    onchange="updateSessionMode()"
                >

                Handmatig pakket
            </label>

            <label>
                <input
                    type="radio"
                    name="sessionMode"
                    value="single"
                    onchange="updateSessionMode()"
                >

                Losse challenge
            </label>

        </div>


        <!-- WILLEKEURIG -->

        <div id="randomPackageOptions">

            <p class="muted">
                BreachOut kiest automatisch
                <strong>10 challenges</strong>:
                2 uit ieder niveau.
            </p>

            <p class="muted">
                De volgorde loopt automatisch
                van niveau 1 naar niveau 5.
            </p>

        </div>


        <!-- HANDMATIG -->

        <div
            id="manualPackageOptions"
            class="hidden"
        >

            <p class="muted">
                Kies precies 10 challenges.
                BreachOut sorteert ze automatisch
                van makkelijk naar moeilijk.
            </p>

            <div
                id="manualPackageCount"
                style="
                    margin: 12px 0;
                    font-weight: bold;
                    color: #35f29a;
                "
            >
                0 / 10 geselecteerd
            </div>

            <div
                id="manualChallengeList"
                style="
                    max-height: 390px;
                    overflow-y: auto;
                    padding: 14px;
                    border: 1px solid #20392b;
                    border-radius: 10px;
                    background: #08110c;
                "
            ></div>

        </div>


        <!-- LOSSE CHALLENGE -->

        <div
            id="singleOptions"
            class="hidden"
        >

            <div class="form-group">

                <label>
                    Challenge
                </label>

                <select
                    id="singleChallenge"
                ></select>

            </div>

        </div>


        <div
            id="startSessionError"
            class="error-message hidden"
        ></div>


        <div class="modal-actions">

            <button
                class="btn-secondary"
                onclick="closeModal('startSessionModal')"
            >
                Annuleren
            </button>

            <button
                class="btn-primary"
                onclick="startSession()"
            >
                Start sessie
            </button>

        </div>

    </div>

</div>


<!-- =========================================

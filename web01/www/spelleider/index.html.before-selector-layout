/* =========================================
   SESSIE STARTEN
========================================= */

function openStartModal(
    teamId
) {
    const team =
        teams.find(
            item =>
                item.id === teamId
        );

    if (!team) {
        return;
    }

    if (!team.active) {
        alert(
            "Dit teamaccount is uitgeschakeld."
        );

        return;
    }

    document
        .getElementById(
            "startTeamId"
        )
        .value =
            team.id;

    document
        .getElementById(
            "startSessionTitle"
        )

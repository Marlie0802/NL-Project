   BERICHTEN
========================================= */

function setQuickMessage(
    minutes
) {
    document
        .getElementById(
            "messageType"
        )
        .value =
            "message";

    document
        .getElementById(
            "messageText"
        )
        .value =
            `Nog ${minutes} minuten resterend.`;
}


async function sendMessage() {
    if (!selectedSessionId) {
        return;
    }

    const message =
        value(
            "messageText"
        )
        .trim();

    const type =
        value(
            "messageType"
        );

    const error =
        document
            .getElementById(
                "messageError"
            );

    error.classList.add(
        "hidden"
    );

    if (!message) {
        error.textContent =
            "Vul eerst een bericht in.";

        error.classList.remove(
            "hidden"
        );

        return;
    }

    try {
        await api(
            `/api/gameleader/sessions/${selectedSessionId}/messages`,
            {
                method: "POST",

                headers:
                    jsonHeaders(),

                body:
                    JSON.stringify({
                        message:
                            message,

                        message_type:
                            type
                    })
            }
        );

        document
            .getElementById(
                "messageText"
            )
            .value = "";

        await loadMessages();

    } catch (err) {
        error.textContent =
            err.message;

        error.classList.remove(
            "hidden"
        );
    }
}


async function loadMessages() {
    if (!selectedSessionId) {
        return;
    }

    const data =
        await api(
            `/api/gameleader/sessions/${selectedSessionId}/messages`
        );

    const messages =
        data.messages || [];

    const container =
        document
            .getElementById(
                "messageHistory"
            );

    if (!messages.length) {
        container.innerHTML = `
            <div class="empty">
                Nog geen berichten verstuurd.
            </div>
        `;

        return;
    }

    container.innerHTML =
        messages
            .slice()
            .reverse()
            .map(
                message => `
                    <div
                        class="message-row ${
                            message.type
                            === "hint"
                            ? "hint"
                            : ""
                        }"
                    >

                        <div class="message-row-head">

                            <span>
                                ${
                                    message.type
                                    === "hint"
                                    ? "Hint"
                                    : "Bericht"
                                }
                            </span>

                            <span>
                                ${formatDate(
                                    message.created_at
                                )}
                            </span>

                        </div>

                        <div>
                            ${escapeHtml(
                                message.text
                            )}
                        </div>

                    </div>
                `
            )
            .join("");
}


/* =========================================
   STOPPEN
========================================= */

async function stopTeamSession(
    sessionId
) {
    if (!sessionId) {
        return;
    }

    if (
        !confirm(
            "Weet je zeker dat je deze sessie wilt stoppen?"
        )
    ) {
        return;
    }

    try {
        await api(
            `/api/gameleader/sessions/${sessionId}/stop`,
            {
                method: "POST"
            }
        );

        await Promise.all([
            loadSessions(),
            loadTeams()
        ]);

        refreshDashboard();

    } catch (err) {
        alert(
            err.message
        );
    }
}



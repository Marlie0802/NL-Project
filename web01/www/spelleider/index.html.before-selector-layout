/* =========================================
   DASHBOARD
========================================= */

function updateStats() {
    const active =
        sessions.filter(
            session =>
                session.status
                === "active"
        );

    const completed =
        sessions.filter(
            session =>
                session.status
                === "completed"
        );

    const wrongAnswers =
        sessions.reduce(
            (total, session) =>
                total +
                Number(
                    session.wrong_attempts
                    || 0
                ),
            0
        );

    const hints =
        sessions.reduce(
            (total, session) =>
                total +
                Number(
                    session.hints_used
                    || 0
                ),
            0
        );

    const highscore =
        sessions.reduce(
            (highest, session) =>
                Math.max(
                    highest,
                    Number(
                        session.score
                        || 0
                    )
                ),
            0
        );

    document
        .getElementById(
            "statActiveSessions"
        )
        .textContent =
            active.length;

    document
        .getElementById(
            "statCompletedSessions"
        )
        .textContent =
            completed.length;

    document
        .getElementById(
            "statWrongAnswers"
        )
        .textContent =
            wrongAnswers;

    document
        .getElementById(
            "statHints"
        )
        .textContent =
            hints;

    document
        .getElementById(
            "statHighscore"
        )
        .textContent =
            highscore;
}


function refreshDashboard() {
    const active =
        sessions.filter(
            session =>
                session.status
                === "active"
        );

    const container =
        document
            .getElementById(
                "dashboardSessions"
            );

    if (!active.length) {
        container.innerHTML = `
            <div class="empty">
                Er zijn momenteel geen actieve sessies.
            </div>
        `;

        return;
    }

    container.innerHTML = `
        <table>
            <thead>
                <tr>
                    <th>Team</th>
                    <th>Voortgang</th>
                    <th>Fouten</th>
                    <th>Hints</th>
                    <th>Punten</th>
                    <th>Acties</th>
                </tr>
            </thead>

            <tbody>
                ${active.map(
                    session => `
                        <tr>

                            <td>
                                ${escapeHtml(
                                    session.team.display_name
                                )}
                            </td>

                            <td>
                                ${session.current}
                                /
                                ${session.total}
                            </td>

                            <td>
                                ${session.wrong_attempts}
                            </td>

                            <td>
                                ${session.hints_used}
                            </td>

                            <td class="score">
                                ${session.score}
                            </td>

                            <td>
                                <button
                                    class="btn-small"
                                    onclick="openSession(
                                        '${session.id}'
                                    )"
                                >
                                    Begeleiden
                                </button>
                            </td>

                        </tr>
                    `
                ).join("")}
            </tbody>
        </table>
    `;
}


function startDashboardRefresh() {
    if (dashboardTimer) {
        clearInterval(
            dashboardTimer
        );
    }

    dashboardTimer =
        setInterval(
            async () => {
                try {
                    await Promise.all([
                        loadSessions(),
                        loadTeams()
                    ]);

                    refreshDashboard();

                } catch {
                    // volgende interval opnieuw
                }
            },
            10000
        );
}



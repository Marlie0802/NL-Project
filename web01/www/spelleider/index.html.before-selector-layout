    scoreboard =
        data.scoreboard || [];

    renderScoreboard();
}


function renderScoreboard() {
    const container =
        document
            .getElementById(
                "scoreboardContainer"
            );

    if (!scoreboard.length) {
        container.innerHTML = `
            <div class="empty">
                Nog geen teams of scores beschikbaar.
            </div>
        `;

        return;
    }

    container.innerHTML = `
        <table>

            <thead>

                <tr>
                    <th>#</th>
                    <th>Team</th>
                    <th>Voortgang</th>
                    <th>Punten</th>
                </tr>

            </thead>

            <tbody>

                ${scoreboard.map(
                    row => `
                        <tr>

                            <td>
                                ${row.position}
                            </td>

                            <td>
                                ${escapeHtml(
                                    row.team
